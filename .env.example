# Configure in Vercel > Project > Settings > Environment Variables.
# Use the dedicated MK Supabase project. Never use a service_role/secret key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# UUID of the MK account created in Supabase Authentication. Must also be in mk_admins.
MK_ADMIN_USER_ID=YOUR_MK_AUTH_USER_UUID
